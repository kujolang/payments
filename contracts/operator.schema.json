{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kujo.payment-operator/v1"
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "authority": {
      "type": "object",
      "properties": {
        "payer": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "type",
            "id",
            "tenant_id"
          ],
          "additionalProperties": false
        },
        "operator": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "type",
            "id",
            "tenant_id"
          ],
          "additionalProperties": false
        },
        "issuer_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "required": [
        "payer",
        "operator",
        "issuer_ref",
        "ttl_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "database",
    "authority"
  ],
  "additionalProperties": false
}
