{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kujo.payment-execution/v1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "principal": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "tenant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "type",
                "id",
                "tenant_id"
              ],
              "additionalProperties": false
            },
            "execution_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "intent_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "payee": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "registry_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "origin": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "required": [
                "id",
                "registry_version",
                "display_name",
                "origin"
              ],
              "additionalProperties": false
            },
            "charge": {
              "type": "object",
              "properties": {
                "minor": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "minor",
                "currency"
              ],
              "additionalProperties": false
            },
            "currency_table_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "request_binding": {
              "type": "object",
              "properties": {
                "route_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "route_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "resource_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "terms_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "route_id",
                "route_version",
                "resource_ref",
                "terms_digest"
              ],
              "additionalProperties": false
            },
            "payment_profile": {
              "type": "object",
              "properties": {
                "alias": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "alias",
                "version"
              ],
              "additionalProperties": false
            },
            "shipping_profile": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "required": [
                    "alias",
                    "version"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "adapter_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "account_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "id",
                "adapter_version",
                "account_ref"
              ],
              "additionalProperties": false
            },
            "execution_class": {
              "enum": [
                "machine",
                "provider_hosted",
                "browser_injection"
              ]
            },
            "capabilities_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expires_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "principal",
            "execution_id",
            "intent_digest",
            "payee",
            "charge",
            "currency_table_version",
            "request_binding",
            "payment_profile",
            "shipping_profile",
            "provider",
            "execution_class",
            "capabilities_digest",
            "expires_at_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "awaiting_authorization",
        "ready",
        "executing",
        "reconciliation_required",
        "succeeded",
        "closed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "submission_claimed": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 100
    },
    "closed_reason": {
      "oneOf": [
        {
          "enum": [
            "denied",
            "expired",
            "cancelled",
            "unsupported",
            "failed_no_effect"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "human_action",
                "operator_review"
              ]
            },
            "action_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "kind",
            "action_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "execution_id",
    "intent_id",
    "intent_digest",
    "snapshot",
    "snapshot_digest",
    "state",
    "revision",
    "created_at_ms",
    "updated_at_ms",
    "submission_claimed",
    "evidence_refs",
    "closed_reason",
    "next_action"
  ],
  "additionalProperties": false
}
