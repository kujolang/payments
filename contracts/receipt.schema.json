{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kujo.payment-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed_no_effect"
      ]
    },
    "observed_amount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "minor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "minor",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "confirmation_rule_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "assurance": {
      "enum": [
        "provider_confirmed",
        "merchant_and_provider_confirmed",
        "operator_verified"
      ]
    }
  },
  "required": [
    "schema",
    "receipt_id",
    "execution_id",
    "snapshot_digest",
    "outcome",
    "observed_amount",
    "observed_at_ms",
    "evidence_ref",
    "confirmation_rule_ref",
    "assurance"
  ],
  "additionalProperties": false
}
