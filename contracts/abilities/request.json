{
  "schema": "kujo.ability/v1",
  "id": "kujo.payments.intent.request",
  "version": "1.0.0",
  "description": "Request one purchase for separate authorization; returns an execution ID without credentials.",
  "input_schema": {
    "type": "object",
    "properties": {
      "purchase_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "payee_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "amount": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "exact",
              "maximum"
            ]
          },
          "minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "mode",
          "minor",
          "currency"
        ],
        "additionalProperties": false
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "payment_profile": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "shipping_profile": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "provider_preference": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "expires_in_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400000
      }
    },
    "required": [
      "purchase_ref",
      "payee_ref",
      "amount",
      "purpose",
      "payment_profile",
      "expires_in_ms"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "execution_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "status": {
        "enum": [
          "awaiting_authorization",
          "ready",
          "executing",
          "reconciliation_required",
          "succeeded",
          "closed"
        ]
      },
      "next_action": {
        "enum": [
          "none",
          "await_authorization",
          "await_provider",
          "operator_review",
          "inspect_receipt"
        ]
      },
      "receipt_ref": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "execution_id",
      "status",
      "next_action",
      "receipt_ref"
    ],
    "additionalProperties": false
  },
  "effects": [
    {
      "kind": "write",
      "resource": "kujo.payments.intent"
    },
    {
      "kind": "external",
      "resource": "kujo.payments.purchase"
    }
  ],
  "idempotency": {
    "mode": "keyed"
  }
}
