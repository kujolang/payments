{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kujo.payment-observation/v1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "snapshot_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "enum": [
        "authorization",
        "execution"
      ]
    },
    "outcome": {
      "enum": [
        "pending",
        "authorized",
        "denied",
        "expired",
        "succeeded",
        "failed_no_effect",
        "unknown"
      ]
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidence_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_amount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "minor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "minor",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "human_action",
                "operator_review"
              ]
            },
            "action_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "kind",
            "action_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_after_ms": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "execution_id",
    "snapshot_digest",
    "phase",
    "outcome",
    "observed_at_ms",
    "evidence_ref",
    "actual_amount",
    "next_action",
    "retry_after_ms"
  ],
  "additionalProperties": false
}
