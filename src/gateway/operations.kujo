from src.application.contracts import valid_store
from ability import create_ability_registry, register_ability_definition, register_ability_binding, register_ability_exposure, execute_ability, validate_ability_value
from src.domain.binding import frame, principal_digest
from src.domain.validation import valid_intent
from src.domain.lifecycle import summary
from src.identity.canonical import canonical_ability_matches

func request_digest(input) {
    mut parts := ["kujo.payment-request-binding/v1",input["purchase_ref"],input["payee_ref"],input["amount"]["mode"],to_string(input["amount"]["minor"]),input["amount"]["currency"],input["purpose"],input["payment_profile"],to_string(input["expires_in_ms"])]
    for field in ["shipping_profile","provider_preference"] {
        if has_key(input,field) { parts = push(parts,"1"); parts = push(parts,input[field]) }
        else { parts = push(parts,"0") }
    }
    return sha256(frame(parts))
}
export decode_gateway_request := func(body) {
    if type(body) != "string" || byte_length(body) > 8192 { return {"ok":false,"code":"invalid_request"} }
    try {
        value := parse_json(body)
        if type(value) != "dict" { return {"ok":false,"code":"invalid_request"} }
        return {"ok":true,"value":value}
    } except e { return {"ok":false,"code":"invalid_request"} }
}
export gateway_call := func(store, request, transport_context, config) {
    if valid_store(store) == false { return {"ok":false,"code":"invalid_store"} }
    // transport_context comes from the authenticated server, never request JSON.
    // This embedding API is not itself a process or network isolation boundary.
    try {
        if type(request) != "dict" { return {"ok":false,"code":"invalid_request"} }
        for key in keys(request) {
            if contains(["operation","input","idempotency_key"],key) == false { return {"ok":false,"code":"invalid_request"} }
        }
        if has_key(request,"operation") == 0 || has_key(request,"input") == 0 { return {"ok":false,"code":"invalid_request"} }
        operation := request["operation"]
        if contains(["request","inspect","inspect_revision","cancel"],operation) == false { return {"ok":false,"code":"operation_denied"} }
        authenticate := config["authenticate"]
        principal := authenticate(transport_context)
        if json_schema_validate(principal,config["intent_schema"]["properties"]["principal"])["valid"] == false { return {"ok":false,"code":"unauthenticated"} }
        scope := principal_digest(principal)
        definition := config["definitions"][operation]
        if canonical_ability_matches(operation,definition) == false { return {"ok":false,"code":"definition_identity_mismatch"} }
        input := request["input"]
        if validate_ability_value(input,definition["input_schema"],"input")["ok"] == false { return {"ok":false,"code":"invalid_request"} }
        if operation == "cancel" {
            if type(input["expected_revision"]) != "int" { return {"ok":false,"code":"invalid_request"} }
            if has_key(store,"cancel") == 0 || type(store["cancel"]) != "function" { return {"ok":false,"code":"store_operation_unavailable"} }
        }
        mut key := ""
        if has_key(request,"idempotency_key") { key = request["idempotency_key"] }
        if type(key) != "string" || len(key) > 128 || ((operation == "request" || operation == "cancel") && len(key) < 1) { return {"ok":false,"code":"invalid_idempotency_key"} }
        if (operation == "inspect" || operation == "inspect_revision") && key != "" { return {"ok":false,"code":"status_is_intrinsic"} }
        clock := config["clock_ms"]
        now := clock()
        mut identity_key := key
        if operation == "inspect" || operation == "inspect_revision" { identity_key = to_string(now) + ":" + input["execution_id"] }
        invocation_id := "gateway:" + sha256(frame([config["namespace"],scope,operation,identity_key]))
        handler := func(payload, context) {
            if operation == "inspect" || operation == "inspect_revision" {
                row := store["inspect"](scope,payload["execution_id"])
                if row == null { return {"ok":false,"code":"not_found","message":"Payment not found","details":{}} }
                value := summary(row)
                if operation == "inspect_revision" { value["revision"] = row["revision"] }
                return {"ok":true,"result":value}
            }
            if operation == "cancel" {
                if store["cancel"](scope,payload["execution_id"],payload["expected_revision"]) != true { return {"ok":false,"code":"cancel_conflict","message":"Payment cancellation was not committed; inspect current status","details":{}} }
                return {"ok":true,"result":summary(store["inspect"](scope,payload["execution_id"]))}
            }
            if type(payload["expires_in_ms"]) != "int" { return {"ok":false,"code":"invalid_request","message":"Invalid purchase","details":{}} }
            expiry := now + payload["expires_in_ms"]
            execution_id := "execution:" + sha256(frame([config["namespace"],scope,payload["purchase_ref"]]))
            intent := {"schema":"kujo.payment-intent/v1","intent_id":"intent:"+sha256(execution_id),"purchase_ref":payload["purchase_ref"],"principal":principal,"kind":"purchase","payee_ref":payload["payee_ref"],"amount":payload["amount"],"purpose":payload["purpose"],"expires_at_ms":expiry,"payment_profile":payload["payment_profile"],"correlation_id":invocation_id}
            for field in ["shipping_profile","provider_preference"] { if has_key(payload,field) { intent[field] := payload[field] } }
            if valid_intent(intent,config["intent_schema"],config["currency_table"],now) == false { return {"ok":false,"code":"invalid_request","message":"Invalid purchase","details":{}} }
            admitted := store["intake"](scope,sha256(key),request_digest(payload),execution_id,intent)
            if admitted["ok"] == false { return {"ok":false,"code":admitted["code"],"message":"Purchase request conflicts or is unavailable","details":{}} }
            return {"ok":true,"result":summary(store["inspect"](scope,admitted["execution_id"]))}
        }
        mut surface := "agent"
        if operation == "cancel" || operation == "inspect_revision" { surface = "sdk" }
        mut registry := create_ability_registry()
        registered := register_ability_definition(registry,definition)
        assert(registered["ok"],"definition")
        registry = registered["registry"]
        bound := register_ability_binding(registry,{"schema":"kujo.ability.binding/v1","ability_id":definition["id"],"ability_version":definition["version"],"handler_id":"kujo.payments.gateway."+operation,"handler_version":"1.0.0","handler":handler,"result_mode":"kujo.result/v1","timeout_ms":2000,"metadata":{}})
        assert(bound["ok"],"binding")
        registry = bound["registry"]
        exposed := register_ability_exposure(registry,{"schema":"kujo.ability.exposure/v1","ability_id":definition["id"],"ability_version":definition["version"],"surface":surface,"name":operation,"enabled":true,"public":false,"metadata":{}})
        assert(exposed["ok"],"exposure")
        registry = exposed["registry"]
        invocation := {"schema":"kujo.ability.invocation/v1","invocation_id":invocation_id,"ability_id":definition["id"],"ability_version":definition["version"],"definition_digest":"","input":input,"principal":principal,"request_id":invocation_id,"trace_id":invocation_id,"surface":surface,"idempotency_key":key,"approval":{},"metadata":{}}
        // New cancellation journals add an application binding to Ability's
        // supplied identity. Existing operations and receipt hashes stay intact.
        stored_identity := func(key_digest,digest) {
            if operation != "cancel" { return {"key":key_digest,"request":digest} }
            return {"key":sha256(frame(["kujo.payment-cancel-key/v1",scope,key_digest])),"request":sha256(frame(["kujo.payment-cancel-store-binding/v1",scope,digest,input["execution_id"],to_string(input["expected_revision"])]))}
        }
        begin := func(key_digest, digest, inv) { bound_identity := stored_identity(key_digest,digest);return store["begin_ability"](inv["ability_id"],bound_identity["key"],bound_identity["request"],inv["invocation_id"]) }
        complete := func(key_digest, digest, receipt) { bound_identity := stored_identity(key_digest,digest);return store["complete_ability"](receipt["ability_id"],bound_identity["key"],bound_identity["request"],receipt) }
        result := execute_ability(registry,invocation,{"clock_ms":clock,"policy":config["policy"],"audit":config["audit"],"begin_idempotency":begin,"complete_idempotency":complete})
        // A replayed Ability receipt is not proof that its purchase terms match.
        // Verify the persisted payment-specific field binding before acknowledging
        // either success or a safe summary after audit failure. This also covers
        // concurrent intake/replay without changing existing Ability digests.
        if operation == "request" && has_key(result,"receipt") {
            candidate := result["receipt"]["result"]
            if validate_ability_value(candidate,definition["output_schema"],"output")["ok"] {
                authoritative := store["inspect"](scope,candidate["execution_id"])
                if authoritative == null || authoritative["request_digest"] != request_digest(input) { return {"ok":false,"code":"idempotency_conflict"} }
            }
        }
        if operation == "cancel" && has_key(result,"receipt") {
            candidate := result["receipt"]["result"]
            if validate_ability_value(candidate,definition["output_schema"],"output")["ok"] {
                authoritative := store["inspect"](scope,input["execution_id"])
                if candidate["execution_id"] != input["execution_id"] || authoritative == null || authoritative["state"] != "closed" || authoritative["closed_reason"] != "cancelled" { return {"ok":false,"code":"cancellation_unconfirmed"} }
            }
        }
        // A live or interrupted invocation may have committed its domain effect
        // without an Ability receipt. Observe it; never reopen or complete it here.
        // The exact Ability error is only returned after policy and audit checks.
        if has_key(result,"code") && result["code"] == "ability_invocation_in_progress" {
            mut observed := null
            if operation == "request" && type(input["expires_in_ms"]) == "int" && type(input["amount"]["minor"]) == "int" {
                if has_key(store,"inspect_request") && type(store["inspect_request"]) == "function" {
                    observed = store["inspect_request"](scope,sha256(key),request_digest(input))
                }
            }
            if operation == "cancel" { observed = store["inspect"](scope,input["execution_id"]) }
            if observed != null {
                value := summary(observed)
                if validate_ability_value(value,definition["output_schema"],"output")["ok"] {
                    return {"ok":false,"code":"operation_incomplete","result":value}
                }
            }
        }
        // Only a compact domain summary crosses the model-facing boundary.
        if result["ok"] == true { return {"ok":true,"result":result["receipt"]["result"]} }
        if has_key(result,"receipt") {
            receipt := result["receipt"]
            if validate_ability_value(receipt["result"],definition["output_schema"],"output")["ok"] {
                return {"ok":false,"code":"operation_receipt_failed","result":receipt["result"]}
            }
        }
        return {"ok":false,"code":"request_not_completed"}
    } except e { return {"ok":false,"code":"gateway_unavailable"} }
}
