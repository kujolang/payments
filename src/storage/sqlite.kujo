from src.domain.lifecycle import transition

func schema_version(db) {
    tables := db_query(db,"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'",[])
    if len(tables) == 0 { return 0 }
    marker := db_query(db,"SELECT name FROM sqlite_master WHERE type='table' AND name='payments_meta'",[])
    assert(len(marker) == 1,"payments_schema_unknown")
    versions := db_query(db,"SELECT version FROM payments_meta",[])
    assert(len(versions) == 1 && type(versions[0]["version"]) == "int","payments_schema_invalid")
    version := versions[0]["version"]
    assert(version == 1 || version == 2,"payments_schema_unsupported")
    return version
}
func configure(db) {
    // SQLite can return BUSY immediately when concurrent connections switch
    // journal modes, despite busy_timeout. Retry only this nonfinancial setup.
    deadline := current_timestamp()+5000
    mut configured := false
    while configured == false && current_timestamp() < deadline {
        try { db_query(db,"PRAGMA journal_mode=WAL",[]); configured = true }
        except error {
            assert(contains(to_string(error),"database is locked") == 1,"payments_journal_configuration_failed")
            if current_timestamp() < deadline { sleep(25) }
        }
    }
    assert(configured,"payments_journal_configuration_timeout")
    db_query(db,"PRAGMA synchronous=FULL",[])
    db_query(db,"PRAGMA foreign_keys=ON",[])
}
func initialize_schema(db) {
    db_execute(db, "CREATE TABLE IF NOT EXISTS payments_meta(version INTEGER PRIMARY KEY CHECK(version=2))", [])
    db_execute(db, "INSERT OR IGNORE INTO payments_meta VALUES(2)", [])
    db_execute(db, "CREATE TABLE IF NOT EXISTS executions(execution_id TEXT PRIMARY KEY, scope TEXT NOT NULL, purchase_ref TEXT NOT NULL, request_digest TEXT NOT NULL, intent_json TEXT NOT NULL, snapshot_json TEXT, snapshot_digest TEXT, state TEXT NOT NULL CHECK(state IN ('awaiting_authorization','ready','executing','reconciliation_required','succeeded','closed')), revision INTEGER NOT NULL DEFAULT 0, expires_at_ms INTEGER NOT NULL, claimed INTEGER NOT NULL DEFAULT 0 CHECK(claimed IN (0,1)), invocation_id TEXT, closed_reason TEXT, receipt_json TEXT, UNIQUE(scope,purchase_ref), CHECK(claimed=0 OR state NOT IN ('ready','awaiting_authorization')))", [])
    db_execute(db, "CREATE TABLE IF NOT EXISTS request_keys(scope TEXT NOT NULL,key_hash TEXT NOT NULL,request_digest TEXT NOT NULL,execution_id TEXT NOT NULL REFERENCES executions(execution_id),PRIMARY KEY(scope,key_hash))", [])
    db_execute(db, "CREATE TABLE IF NOT EXISTS approvals(approval_id TEXT PRIMARY KEY,execution_id TEXT NOT NULL REFERENCES executions(execution_id),scope TEXT NOT NULL,snapshot_digest TEXT NOT NULL,invocation_id TEXT NOT NULL,binding_digest TEXT NOT NULL,issuer_ref TEXT NOT NULL,nonce TEXT NOT NULL,expires_at_ms INTEGER NOT NULL,consumed INTEGER NOT NULL DEFAULT 0 CHECK(consumed IN (0,1)),UNIQUE(issuer_ref,nonce))", [])
    db_execute(db, "CREATE TABLE IF NOT EXISTS observations(execution_id TEXT NOT NULL REFERENCES executions(execution_id),evidence_id TEXT NOT NULL,digest TEXT NOT NULL,observation_json TEXT NOT NULL,PRIMARY KEY(execution_id,evidence_id))", [])
    db_execute(db, "CREATE TRIGGER IF NOT EXISTS permanent_claim BEFORE UPDATE OF claimed ON executions WHEN OLD.claimed=1 AND NEW.claimed!=1 BEGIN SELECT RAISE(ABORT,'permanent_claim'); END", [])
    db_execute(db, "CREATE TRIGGER IF NOT EXISTS permanent_execution BEFORE DELETE ON executions BEGIN SELECT RAISE(ABORT,'permanent_execution'); END", [])
    db_execute(db,"CREATE TABLE IF NOT EXISTS incidents(execution_id TEXT NOT NULL REFERENCES executions(execution_id),evidence_id TEXT NOT NULL,digest TEXT NOT NULL,code TEXT NOT NULL,PRIMARY KEY(execution_id,evidence_id,digest,code))",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS immutable_snapshot BEFORE UPDATE OF snapshot_json,snapshot_digest ON executions WHEN OLD.snapshot_json IS NOT NULL AND (NEW.snapshot_json IS NOT OLD.snapshot_json OR NEW.snapshot_digest IS NOT OLD.snapshot_digest) BEGIN SELECT RAISE(ABORT,'immutable_snapshot'); END",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS immutable_terminal BEFORE UPDATE OF state,receipt_json ON executions WHEN OLD.state IN ('succeeded','closed') AND (NEW.state!=OLD.state OR NEW.receipt_json IS NOT OLD.receipt_json) BEGIN SELECT RAISE(ABORT,'immutable_terminal'); END",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS preparations(execution_id TEXT PRIMARY KEY REFERENCES executions(execution_id),prepared_ref TEXT NOT NULL,provider_id TEXT NOT NULL)",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS ability_calls(operation TEXT NOT NULL,key_digest TEXT NOT NULL,request_digest TEXT NOT NULL,invocation_id TEXT NOT NULL,receipt_json TEXT,PRIMARY KEY(operation,key_digest))",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS audit(event_id TEXT PRIMARY KEY,execution_id TEXT,phase TEXT NOT NULL)",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS issued_approvals(approval_id TEXT PRIMARY KEY REFERENCES approvals(approval_id),approval_json TEXT NOT NULL)",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS provider_authorizations(execution_id TEXT PRIMARY KEY REFERENCES executions(execution_id),started INTEGER NOT NULL CHECK(started=1))",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS execution_control(id INTEGER PRIMARY KEY CHECK(id=1),mode TEXT NOT NULL CHECK(mode IN ('active','paused')),revision INTEGER NOT NULL CHECK(revision>=0))",[])
    db_execute(db,"INSERT OR IGNORE INTO execution_control VALUES(1,'active',0)",[])
    db_execute(db,"CREATE TABLE IF NOT EXISTS execution_control_events(revision INTEGER PRIMARY KEY,mode TEXT NOT NULL,actor_ref TEXT NOT NULL,changed_at_ms INTEGER NOT NULL)",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS permanent_execution_control BEFORE DELETE ON execution_control BEGIN SELECT RAISE(ABORT,'permanent_execution_control'); END",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS stopped_claim BEFORE UPDATE OF claimed ON executions WHEN OLD.claimed=0 AND NEW.claimed=1 AND NOT EXISTS(SELECT 1 FROM execution_control WHERE id=1 AND mode='active') BEGIN SELECT RAISE(ABORT,'execution_paused'); END",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS stopped_native_authorization BEFORE INSERT ON provider_authorizations WHEN NOT EXISTS(SELECT 1 FROM execution_control WHERE id=1 AND mode='active') BEGIN SELECT RAISE(ABORT,'execution_paused'); END",[])
    for event in ["UPDATE","DELETE"] {
        db_execute(db,"CREATE TRIGGER IF NOT EXISTS permanent_control_events_"+event+" BEFORE "+event+" ON execution_control_events BEGIN SELECT RAISE(ABORT,'permanent_control_events'); END",[])
    }
    for statement in parse_json(read_file("contracts/storage/quarantine.sql.json")) { db_execute(db,statement,[]) }
    db_execute(db,"CREATE TABLE IF NOT EXISTS schema_history(version INTEGER PRIMARY KEY,from_version INTEGER NOT NULL,source_digest TEXT,actor_ref TEXT NOT NULL,applied_at_ms INTEGER NOT NULL)",[])
    for event in ["UPDATE","DELETE"] { db_execute(db,"CREATE TRIGGER IF NOT EXISTS permanent_schema_history_"+event+" BEFORE "+event+" ON schema_history BEGIN SELECT RAISE(ABORT,'permanent_schema_history'); END",[]) }
}

func validate_history(db) {
    rows := db_query(db,"SELECT from_version,source_digest FROM schema_history WHERE version=2",[])
    assert(len(rows) == 1,"payments_schema_history_missing")
    row := rows[0]
    assert((row["from_version"] == 0 && row["source_digest"] == null) || (row["from_version"] == 1 && row["source_digest"] == sha256(read_file("contracts/storage/v1-baseline.json"))),"payments_schema_history_invalid")
}

// Schema creation is one transaction. Only a successful current-invocation claim
// authorizes dispatch; neither schema initialization nor migration creates one.
export open_store := func(path) {
    db := db_connect("sqlite",path)
    try {
        db_query(db,"PRAGMA busy_timeout=5000",[])
        initial := schema_version(db)
        assert(initial != 1,"payments_schema_migration_required")
        if initial == 2 { validate_schema(db,"contracts/storage/v2-baseline.json"); validate_history(db) }
        configure(db)
        db_execute(db,"BEGIN IMMEDIATE",[])
        version := schema_version(db)
        assert(version == 0 || version == 2,"payments_schema_migration_required")
        if version == 0 { initialize_schema(db) }
        if version == 0 { db_execute(db,"INSERT INTO schema_history VALUES(2,0,NULL,'initialization',?)",[current_timestamp()]) }
        validate_schema(db,"contracts/storage/v2-baseline.json")
        validate_history(db)
        db_execute(db,"COMMIT",[])
    } except error {
        try { db_execute(db,"ROLLBACK",[]) } except rollback_error { }
        db_close(db)
        assert(false,"payments_store_open_failed")
    }
    return db
}
func validate_schema(db, path) {
    for expected in parse_json(read_file(path)) {
        actual := db_query(db,"SELECT type,sql FROM sqlite_master WHERE name=?",[expected["name"]])
        assert(len(actual) == 1 && actual[0]["type"] == expected["type"] && actual[0]["sql"] == expected["sql"],"payments_schema_drift")
    }
}
func validate_v1(db) {
    validate_schema(db,"contracts/storage/v1-baseline.json")
    assert(len(db_query(db,"SELECT name FROM sqlite_master WHERE name='schema_history' OR name LIKE 'permanent_schema_history_%'",[])) == 0,"payments_migration_history_conflict")
}
export migrate_store := func(path, actor_ref, now_ms) {
    assert(type(actor_ref) == "string" && regex_match(actor_ref,"^[A-Za-z0-9_.:-]{1,128}$") && type(now_ms) == "int" && now_ms >= 0,"payments_migration_authority")
    db := db_connect("sqlite",path)
    try {
        db_query(db,"PRAGMA busy_timeout=5000",[])
        version := schema_version(db)
        assert(version == 1 || version == 2,"payments_migration_source_required")
        configure(db)
        db_execute(db,"BEGIN IMMEDIATE",[])
        current := schema_version(db)
        if current == 1 {
            validate_v1(db)
            integrity := db_query(db,"PRAGMA integrity_check",[])
            assert(len(integrity) == 1 && integrity[0]["integrity_check"] == "ok" && len(db_query(db,"PRAGMA foreign_key_check",[])) == 0,"payments_migration_integrity")
            db_execute(db,"UPDATE execution_control SET mode='paused',revision=revision+1 WHERE id=1",[])
            control := db_query(db,"SELECT mode,revision FROM execution_control WHERE id=1",[])
            assert(len(control) == 1 && control[0]["mode"] == "paused","payments_migration_control")
            db_execute(db,"INSERT INTO execution_control_events VALUES(?,'paused',?,?)",[control[0]["revision"],actor_ref,now_ms])
            db_execute(db,"DROP TABLE payments_meta",[])
            initialize_schema(db)
            db_execute(db,"INSERT INTO schema_history VALUES(2,1,?,?,?)",[sha256(read_file("contracts/storage/v1-baseline.json")),actor_ref,now_ms])
        } else { assert(current == 2,"payments_migration_version_changed") }
        validate_schema(db,"contracts/storage/v2-baseline.json")
        validate_history(db)
        db_execute(db,"COMMIT",[])
    } except error {
        try { db_execute(db,"ROLLBACK",[]) } except rollback_error { }
        db_close(db)
        assert(false,"payments_migration_failed")
    }
    return db
}

export inspect := func(db, scope, execution_id) {
    rows := db_query(db, "SELECT * FROM executions WHERE scope=? AND execution_id=?", [scope, execution_id])
    if len(rows) == 0 { return null }
    return rows[0]
}
// Observation only: both the durable request key and purchase terms must match.
export inspect_request := func(db, scope, key_hash, request_digest) {
    rows := db_query(db,"SELECT e.* FROM request_keys k JOIN executions e ON e.execution_id=k.execution_id AND e.scope=k.scope WHERE k.scope=? AND k.key_hash=? AND k.request_digest=? AND e.request_digest=?",[scope,key_hash,request_digest,request_digest])
    if len(rows) != 1 { return null }
    return rows[0]
}
export intake := func(db, scope, key_hash, request_digest, execution_id, intent) {
    mut result := {"ok": false, "code": "storage_failure"}
    try {
        db_execute(db, "BEGIN IMMEDIATE", [])
        keys := db_query(db, "SELECT request_digest,execution_id FROM request_keys WHERE scope=? AND key_hash=?", [scope,key_hash])
        if len(keys) > 0 {
            if keys[0]["request_digest"] == request_digest { result = {"ok": true,"execution_id":keys[0]["execution_id"],"replay":true} }
            else { result = {"ok":false,"code":"idempotency_conflict"} }
        } else {
            purchases := db_query(db, "SELECT execution_id,request_digest FROM executions WHERE scope=? AND purchase_ref=?", [scope,intent["purchase_ref"]])
            if len(purchases) > 0 {
                if purchases[0]["request_digest"] == request_digest {
                    db_execute(db,"INSERT INTO request_keys VALUES(?,?,?,?)",[scope,key_hash,request_digest,purchases[0]["execution_id"]])
                    result = {"ok":true,"execution_id":purchases[0]["execution_id"],"replay":true}
                } else { result = {"ok":false,"code":"purchase_conflict"} }
            } else {
                db_execute(db, "INSERT INTO executions(execution_id,scope,purchase_ref,request_digest,intent_json,state,expires_at_ms) VALUES(?,?,?,?,?,'awaiting_authorization',?)", [execution_id,scope,intent["purchase_ref"],request_digest,to_json(intent),intent["expires_at_ms"]])
                db_execute(db,"INSERT INTO request_keys VALUES(?,?,?,?)",[scope,key_hash,request_digest,execution_id])
                result = {"ok":true,"execution_id":execution_id,"replay":false}
            }
        }
        db_execute(db, "COMMIT", [])
    } except e {
        try { db_execute(db,"ROLLBACK",[]) } except rollback_error { }
        result = {"ok":false,"code":"storage_failure"}
    }
    return result
}
export prepare := func(db, scope, execution_id, revision, snapshot, digest, now_ms) {
    // Snapshot becomes immutable after this CAS. Caller performs domain validation.
    rows := db_execute(db,"UPDATE executions SET snapshot_json=?,snapshot_digest=?,expires_at_ms=?,revision=revision+1 WHERE execution_id=? AND scope=? AND state='awaiting_authorization' AND claimed=0 AND snapshot_json IS NULL AND revision=? AND expires_at_ms>?",[to_json(snapshot),digest,snapshot["expires_at_ms"],execution_id,scope,revision,now_ms])
    return rows == 1
}
export grant := func(db, scope, execution_id, revision, approval, snapshot_digest, invocation_id, issuer_ref, now_ms) {
    // Authenticated issuer + Ability validation are mandatory application preconditions.
    mut ok := false
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        rows := db_execute(db,"UPDATE executions SET state='ready',revision=revision+1 WHERE execution_id=? AND scope=? AND state='awaiting_authorization' AND snapshot_digest=? AND claimed=0 AND revision=? AND expires_at_ms>?",[execution_id,scope,snapshot_digest,revision,now_ms])
        if rows == 1 && approval["expires_at_ms"] > now_ms {
            db_execute(db,"INSERT INTO approvals VALUES(?,?,?,?,?,?,?,?,?,0)",[approval["approval_id"],execution_id,scope,snapshot_digest,invocation_id,approval["binding_digest"],issuer_ref,approval["nonce"],approval["expires_at_ms"]])
            db_execute(db,"INSERT INTO issued_approvals VALUES(?,?)",[approval["approval_id"],to_json(approval)])
            db_execute(db,"COMMIT",[])
            ok = true
        } else { db_execute(db,"ROLLBACK",[]) }
    } except e { try { db_execute(db,"ROLLBACK",[]) } except rollback_error { } }
    return ok
}
export claim := func(db, scope, execution_id, revision, approval_id, binding_digest, snapshot_digest, invocation_id, now_ms) {
    mut won := false
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        consumed := db_execute(db,"UPDATE approvals SET consumed=1 WHERE approval_id=? AND execution_id=? AND scope=? AND binding_digest=? AND snapshot_digest=? AND invocation_id=? AND expires_at_ms>? AND consumed=0 AND EXISTS(SELECT 1 FROM execution_control WHERE id=1 AND mode='active')",[approval_id,execution_id,scope,binding_digest,snapshot_digest,invocation_id,now_ms])
        if consumed == 1 {
            rows := db_execute(db,"UPDATE executions SET state='executing',claimed=1,invocation_id=?,revision=revision+1 WHERE execution_id=? AND scope=? AND snapshot_digest=? AND state='ready' AND claimed=0 AND revision=? AND expires_at_ms>?",[invocation_id,execution_id,scope,snapshot_digest,revision,now_ms])
            if rows == 1 { db_execute(db,"COMMIT",[]); won = true }
            else { db_execute(db,"ROLLBACK",[]) }
        } else { db_execute(db,"ROLLBACK",[]) }
    } except e { try { db_execute(db,"ROLLBACK",[]) } except rollback_error { } }
    return won
}
export cancel := func(db, scope, execution_id, revision) {
    rows := db_execute(db,"UPDATE executions SET state='closed',closed_reason='cancelled',revision=revision+1 WHERE scope=? AND execution_id=? AND revision=? AND state IN ('awaiting_authorization','ready') AND claimed=0 AND NOT EXISTS(SELECT 1 FROM restore_quarantine)",[scope,execution_id,revision])
    return rows == 1
}
export recover := func(db) {
    // Recovery is observation-only: it never clears a claim or recreates a permit.
    return db_execute(db,"UPDATE executions SET state='reconciliation_required',revision=revision+1 WHERE state='executing' AND claimed=1",[])
}

export record_observation := func(db, scope, execution_id, revision, evidence_id, digest, observation, event, receipt) {
    // Only normalized, authenticated executor observations reach this port.
    // Conflicts are retained without replacing the original evidence or receipt.
    mut result := {"ok":false,"code":"storage_failure"}
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        row := inspect(db,scope,execution_id)
        if row == null { result = {"ok":false,"code":"not_found"} }
        else {
            existing := db_query(db,"SELECT digest FROM observations WHERE execution_id=? AND evidence_id=?",[execution_id,evidence_id])
            if len(existing) > 0 {
                if existing[0]["digest"] == digest { result = {"ok":true,"duplicate":true} }
                else {
                    db_execute(db,"INSERT OR IGNORE INTO incidents VALUES(?,?,?,'evidence_conflict')",[execution_id,evidence_id,digest])
                    db_execute(db,"UPDATE executions SET state='reconciliation_required',revision=revision+1 WHERE execution_id=? AND claimed=1 AND state NOT IN ('closed','succeeded')",[execution_id])
                    result = {"ok":false,"code":"evidence_conflict"}
                }
            } else {
                if row["revision"] != revision { result = {"ok":false,"code":"revision_conflict"} }
                else {
                    next := transition(row["state"],event,row["claimed"] == 1)
                    if next["ok"] == false {
                        db_execute(db,"INSERT OR IGNORE INTO incidents VALUES(?,?,?,'invalid_observation_transition')",[execution_id,evidence_id,digest])
                        result = {"ok":false,"code":"invalid_observation_transition"}
                    } else {
                        mut reason := null
                        mut receipt_json := null
                        if event == "failed_no_effect" { reason = "failed_no_effect" }
                        if receipt != null { receipt_json = to_json(receipt) }
                        if (event == "succeeded" || event == "failed_no_effect") && receipt == null {
                            result = {"ok":false,"code":"receipt_required"}
                        } else {
                            db_execute(db,"INSERT INTO observations VALUES(?,?,?,?)",[execution_id,evidence_id,digest,to_json(observation)])
                            db_execute(db,"UPDATE executions SET state=?,closed_reason=?,receipt_json=?,revision=revision+1 WHERE execution_id=? AND scope=? AND revision=?",[next["state"],reason,receipt_json,execution_id,scope,revision])
                            result = {"ok":true,"duplicate":false}
                        }
                    }
                }
            }
        }
        db_execute(db,"COMMIT",[])
    } except e {
        try { db_execute(db,"ROLLBACK",[]) } except rollback_error { }
        result = {"ok":false,"code":"storage_failure"}
    }
    return result
}

export save_preparation := func(db, scope, execution_id, revision, snapshot, digest, prepared_ref, now_ms) {
    mut ok := false
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        if prepare(db,scope,execution_id,revision,snapshot,digest,now_ms) {
            db_execute(db,"INSERT INTO preparations VALUES(?,?,?)",[execution_id,prepared_ref,snapshot["provider"]["id"]])
            db_execute(db,"COMMIT",[])
            ok = true
        } else { db_execute(db,"ROLLBACK",[]) }
    } except e { try { db_execute(db,"ROLLBACK",[]) } except rollback_error { } }
    return ok
}
export preparation_ref := func(db, scope, execution_id) {
    rows := db_query(db,"SELECT p.prepared_ref FROM preparations p JOIN executions e ON e.execution_id=p.execution_id WHERE e.scope=? AND e.execution_id=?",[scope,execution_id])
    if len(rows) != 1 { return null }
    return rows[0]["prepared_ref"]
}
export begin_ability := func(db, operation, key_digest, request_digest, invocation_id) {
    mut result := {"state":"unavailable"}
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        rows := db_query(db,"SELECT * FROM ability_calls WHERE operation=? AND key_digest=?",[operation,key_digest])
        if len(rows) == 0 {
            db_execute(db,"INSERT INTO ability_calls VALUES(?,?,?,?,NULL)",[operation,key_digest,request_digest,invocation_id])
            result = {"state":"started"}
        } else {
            row := rows[0]
            if row["request_digest"] != request_digest || row["invocation_id"] != invocation_id { result = {"state":"conflict"} }
            else {
                if row["receipt_json"] == null { result = {"state":"in_progress"} }
                else { result = {"state":"replay","receipt":parse_json(row["receipt_json"])} }
            }
        }
        db_execute(db,"COMMIT",[])
    } except e { try { db_execute(db,"ROLLBACK",[]) } except rollback_error { } }
    return result
}
export complete_ability := func(db, operation, key_digest, request_digest, receipt) {
    rows := db_execute(db,"UPDATE ability_calls SET receipt_json=? WHERE operation=? AND key_digest=? AND request_digest=? AND invocation_id=? AND receipt_json IS NULL",[to_json(receipt),operation,key_digest,request_digest,receipt["invocation_id"]])
    return {"ok":rows == 1}
}

export issued_approval_matches := func(db, scope, execution_id, approval) {
    rows := db_query(db,"SELECT i.approval_json FROM issued_approvals i JOIN approvals a ON a.approval_id=i.approval_id WHERE a.approval_id=? AND a.scope=? AND a.execution_id=? AND a.consumed=0",[approval["approval_id"],scope,execution_id])
    return len(rows) == 1 && parse_json(rows[0]["approval_json"]) == approval
}

export begin_provider_authorization := func(db, scope, execution_id) {
    rows := db_execute(db,"INSERT OR IGNORE INTO provider_authorizations SELECT execution_id,1 FROM executions WHERE execution_id=? AND scope=? AND state IN ('awaiting_authorization','ready') AND claimed=0 AND snapshot_json IS NOT NULL AND EXISTS(SELECT 1 FROM execution_control WHERE id=1 AND mode='active')",[execution_id,scope])
    return rows == 1
}

export load_approval := func(db, scope, execution_id) {
    rows := db_query(db,"SELECT i.approval_json FROM issued_approvals i JOIN approvals a ON a.approval_id=i.approval_id JOIN executions e ON e.execution_id=a.execution_id AND e.scope=a.scope WHERE a.scope=? AND a.execution_id=? AND a.consumed=0 AND e.state='ready' AND e.claimed=0",[scope,execution_id])
    if len(rows) != 1 { return null }
    return parse_json(rows[0]["approval_json"])
}

// Privileged database-wide incident control. No agent-facing store port exports it.
export inspect_execution_control := func(db) {
    rows := db_query(db,"SELECT mode,revision FROM execution_control WHERE id=1",[])
    assert(len(rows) == 1,"execution_control_missing")
    return rows[0]
}
export set_execution_control := func(db, mode, revision, actor_ref, now_ms) {
    if (mode != "active" && mode != "paused") || type(revision) != "int" || revision < 0 || type(now_ms) != "int" || now_ms < 0 || type(actor_ref) != "string" || regex_match(actor_ref,"^[A-Za-z0-9_.:-]{1,128}$") == false { return false }
    mut ok := false
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        changed := db_execute(db,"UPDATE execution_control SET mode=?,revision=revision+1 WHERE id=1 AND revision=?",[mode,revision])
        if changed == 1 {
            db_execute(db,"INSERT INTO execution_control_events VALUES(?,?,?,?)",[revision+1,mode,actor_ref,now_ms])
            db_execute(db,"COMMIT",[])
            ok = true
        } else { db_execute(db,"ROLLBACK",[]) }
    } except error { try { db_execute(db,"ROLLBACK",[]) } except rollback_error { } }
    return ok
}
