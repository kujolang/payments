// Privileged Link credential journal. The supplied database must live in the
// executor's private vault, never the generic Payments/Ability journal.
from src.domain.binding import frame
from src.providers.link.api import link_api

func token_valid(value) {
    return type(value) == "string" && len(value) > 0 && len(value) <= 8192 && regex_match(value,"^[A-Za-z0-9._~+/-]+={0,2}$")
}
func scopes(value) {
    assert(type(value) == "string" && len(value) > 0 && len(value) <= 2048,"oauth_scope_invalid")
    assert(regex_match(value,"^[A-Za-z0-9_:./ -]+$"),"oauth_scope_invalid")
    mut words := []
    for word in split(trim(value)," ") { if word != "" && contains(words,word) == false { words = push(words,word) } }
    return to_json(sort(words))
}
func binding_digest(binding) {
    for field in ["tenant_id","payer_ref","account_ref","client_id"] {
        assert(type(binding[field]) == "string" && regex_match(binding[field],"^[A-Za-z0-9_.:-]{1,128}$"),"oauth_binding_invalid")
    }
    assert(regex_match(binding["client_id"],"^[A-Za-z0-9_-]{1,128}$"),"oauth_client_invalid")
    for key in keys(binding) { assert(contains(["tenant_id","payer_ref","account_ref","client_id","scope"],key),"oauth_binding_field") }
    return sha256(frame(["kujo.link-credential-binding/v1",binding["tenant_id"],binding["payer_ref"],binding["account_ref"],binding["client_id"],scopes(binding["scope"])]))
}
func valid_tokens(native,binding,now_ms) {
    if type(native) != "dict" || type(now_ms) != "int" || now_ms < 0 { return false }
    if token_valid(native["access_token"]) == false || token_valid(native["refresh_token"]) == false { return false }
    if type(native["token_type"]) != "string" || to_lower(native["token_type"]) != "bearer" { return false }
    if type(native["expires_in"]) != "int" || native["expires_in"] < 1 || native["expires_in"] > 31536000 || now_ms > 9007199254740991-native["expires_in"]*1000 { return false }
    if scopes(native["scope"]) != scopes(binding["scope"]) { return false }
    // Rich authorization details need a separately reviewed grant comparator.
    if has_key(native,"authorization_details") && native["authorization_details"] != [] { return false }
    return true
}
func unavailable() { return {"ok":false,"code":"link_credentials_unavailable"} }
export open_link_credentials := func(db) {
    db_query(db,"PRAGMA busy_timeout=5000",[])
    db_query(db,"PRAGMA synchronous=FULL",[])
    definitions := [{"name":"link_credentials_v1","sql":"CREATE TABLE link_credentials_v1(id TEXT PRIMARY KEY,binding_digest TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN ('active','rotating','reauthentication_required','disabled')),generation INTEGER NOT NULL CHECK(generation>=0),access_token TEXT,refresh_token TEXT,expires_at_ms INTEGER NOT NULL,CHECK((state='active' AND access_token IS NOT NULL AND refresh_token IS NOT NULL) OR (state!='active' AND access_token IS NULL AND refresh_token IS NULL)))"},{"name":"link_credentials_identity","sql":"CREATE TRIGGER link_credentials_identity BEFORE UPDATE ON link_credentials_v1 WHEN NEW.id!=OLD.id OR NEW.binding_digest!=OLD.binding_digest OR NEW.generation<OLD.generation BEGIN SELECT RAISE(ABORT,'credential_identity_immutable'); END"},{"name":"link_credentials_permanent","sql":"CREATE TRIGGER link_credentials_permanent BEFORE DELETE ON link_credentials_v1 BEGIN SELECT RAISE(ABORT,'credential_identity_permanent'); END"}]
    try {
        db_execute(db,"BEGIN IMMEDIATE",[])
        objects := db_query(db,"SELECT name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'",[])
        version := db_query(db,"PRAGMA user_version",[])[0]["user_version"]
        if len(objects) == 0 && version == 0 {
            for definition in definitions { db_execute(db,definition["sql"],[]) }
            db_execute(db,"PRAGMA user_version=1",[])
        } else {
            assert(version == 1 && len(objects) == len(definitions),"private_credential_schema")
            for definition in definitions {
                rows := db_query(db,"SELECT sql FROM sqlite_master WHERE name=?",[definition["name"]])
                assert(len(rows) == 1 && rows[0]["sql"] == definition["sql"],"private_credential_schema")
            }
        }
        db_execute(db,"COMMIT",[])
    } except error {
        try { db_execute(db,"ROLLBACK",[]) } except rollback_error { }
        assert(false,"private_credential_store_unavailable")
    }
}
export install_link_credentials := func(db,id,binding,native,now_ms) {
    try {
        if type(id) != "string" || regex_match(id,"^[A-Za-z0-9_.:-]{1,128}$") == false || valid_tokens(native,binding,now_ms) == false { return unavailable() }
        digest := binding_digest(binding)
        written := db_execute(db,"INSERT OR IGNORE INTO link_credentials_v1 VALUES(?,?,'active',0,?,?,?)",[id,digest,native["access_token"],native["refresh_token"],now_ms+native["expires_in"]*1000])
        if written != 1 { return unavailable() }
        return {"ok":true,"generation":0}
    } except error { return unavailable() }
}
export inspect_link_credentials := func(db,id,binding) {
    try {
        rows := db_query(db,"SELECT state,generation,expires_at_ms FROM link_credentials_v1 WHERE id=? AND binding_digest=?",[id,binding_digest(binding)])
        if len(rows) != 1 { return unavailable() }
        return {"ok":true,"state":rows[0]["state"],"generation":rows[0]["generation"],"expires_at_ms":rows[0]["expires_at_ms"]}
    } except error { return unavailable() }
}
export disable_link_credentials := func(db,id,binding,generation) {
    try {
        if type(generation) != "int" || generation < 0 { return unavailable() }
        changed := db_execute(db,"UPDATE link_credentials_v1 SET state='disabled',generation=generation+1,access_token=NULL,refresh_token=NULL WHERE id=? AND binding_digest=? AND generation=? AND state!='disabled'",[id,binding_digest(binding),generation])
        return {"ok":changed == 1}
    } except error { return unavailable() }
}
export refresh_link_credentials := func(db,id,binding,generation,refresh,clock_ms,deadline_ms) {
    try {
        started_at_ms := clock_ms()
        if type(started_at_ms) != "int" || started_at_ms < 0 || type(generation) != "int" || generation < 0 || type(deadline_ms) != "int" || started_at_ms+5000 >= deadline_ms { return unavailable() }
        digest := binding_digest(binding)
        rows := db_query(db,"SELECT refresh_token FROM link_credentials_v1 WHERE id=? AND binding_digest=? AND generation=? AND state='active'",[id,digest,generation])
        if len(rows) != 1 { return unavailable() }
        refresh_token := rows[0]["refresh_token"]
        // Commit the one-shot reservation before the native request. Old token
        // bytes may remain in private SQLite pages; this is not secure erasure.
        won := db_execute(db,"UPDATE link_credentials_v1 SET state='rotating',generation=generation+1,access_token=NULL,refresh_token=NULL WHERE id=? AND binding_digest=? AND generation=? AND state='active'",[id,digest,generation])
        if won != 1 { return unavailable() }
        mut result := {"ok":false}
        try { result = refresh(binding["client_id"],refresh_token,deadline_ms) } except error { result = {"ok":false} }
        now_ms := clock_ms()
        if now_ms >= started_at_ms && now_ms < deadline_ms && result["ok"] == true && valid_tokens(result["native"],binding,started_at_ms) && started_at_ms+result["native"]["expires_in"]*1000 > now_ms {
            native := result["native"]
            committed := db_execute(db,"UPDATE link_credentials_v1 SET state='active',access_token=?,refresh_token=?,expires_at_ms=? WHERE id=? AND binding_digest=? AND generation=? AND state='rotating'",[native["access_token"],native["refresh_token"],started_at_ms+native["expires_in"]*1000,id,digest,generation+1])
            if committed == 1 { return {"ok":true,"generation":generation+1} }
        }
        db_execute(db,"UPDATE link_credentials_v1 SET state='reauthentication_required' WHERE id=? AND binding_digest=? AND generation=? AND state='rotating'",[id,digest,generation+1])
        return unavailable()
    } except error { return unavailable() }
}
export link_credential_api := func(db,id,binding,clock_ms) {
    digest := binding_digest(binding)
    return func(method,path,body,deadline_ms) {
        try {
            if type(deadline_ms) != "int" || clock_ms()+5000 >= deadline_ms { return unavailable() }
            rows := db_query(db,"SELECT access_token,expires_at_ms FROM link_credentials_v1 WHERE id=? AND binding_digest=? AND state='active'",[id,digest])
            if len(rows) != 1 || rows[0]["expires_at_ms"] <= deadline_ms { return unavailable() }
            api := link_api(rows[0]["access_token"],clock_ms)
            return api(method,path,body,deadline_ms)
        } except error { return unavailable() }
    }
}
