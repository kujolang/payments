// Trusted installation of the five-method SPI. No model argument chooses these
// callbacks, credentials, account, merchant route or confirmation policy.
from src.domain.binding import frame, intent_digest, snapshot_digest, capabilities_digest, principal_digest
from src.providers.link.authorization import open_link_authorizations, request_link_authorization, observe_link_authorization
from src.providers.link.mpp import validate_mpp_challenge
from src.providers.link.submission import open_link_submissions, prepare_link_submission, submit_link_once, observe_link_submission

export link_provider := func(db, installed, api, merchant, clock_ms) {
    assert(type(api) == "function" && type(clock_ms) == "function","link_host_ports")
    assert(installed["snapshot"]["provider"]["id"] == "link" && installed["snapshot"]["provider"]["adapter_version"] == "0.1.0","link_installation_identity")
    assert(installed["capabilities"]["provider_id"] == "link" && installed["capabilities"]["adapter_version"] == "0.1.0","link_capability_identity")
    assert(installed["snapshot"]["charge"] == installed["expected"]["charge"],"link_installed_charge")
    assert(type(merchant["binding_digest"]) == "string" && regex_match(merchant["binding_digest"],"^[a-f0-9]{64}$"),"link_merchant_binding")
    assert(merchant["origin"] == installed["snapshot"]["payee"]["origin"] && merchant["body_digest"] == installed["expected"]["body_digest"],"link_merchant_destination")
    for key in ["route_id","route_version","resource_ref"] { assert(merchant[key] == installed["snapshot"]["request_binding"][key],"link_merchant_route_identity") }
    for method in ["probe","pay","observe"] { assert(type(merchant[method]) == "function","link_merchant_port") }
    open_link_authorizations(db)
    open_link_submissions(db)
    db_execute(db,"CREATE TABLE IF NOT EXISTS link_provider_prepared(ref TEXT PRIMARY KEY,scope TEXT NOT NULL,execution_id TEXT NOT NULL,installation_digest TEXT NOT NULL,intent_digest TEXT NOT NULL,snapshot_json TEXT NOT NULL,UNIQUE(scope,execution_id))",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS link_provider_prepared_immutable BEFORE UPDATE ON link_provider_prepared BEGIN SELECT RAISE(ABORT,'link_provider_preparation_immutable'); END",[])
    db_execute(db,"CREATE TRIGGER IF NOT EXISTS link_provider_prepared_permanent BEFORE DELETE ON link_provider_prepared BEGIN SELECT RAISE(ABORT,'link_provider_preparation_permanent'); END",[])
    installation_digest := sha256(frame(["kujo.link.installation/v1",snapshot_digest(installed["snapshot"]),capabilities_digest(installed["capabilities"]),to_json(installed["expected"]),installed["payment_method"],to_string(installed["test_mode"]),merchant["binding_digest"]]))
    load := func(ref,context) {
        rows := db_query(db,"SELECT * FROM link_provider_prepared WHERE ref=?",[ref])
        assert(len(rows) == 1,"link_reference_unknown")
        row := rows[0]
        assert(context["tenant_id"] == context["principal"]["tenant_id"],"link_tenant_context")
        assert(row["scope"] == principal_digest(context["principal"]) && row["execution_id"] == context["execution_id"] && row["installation_digest"] == installation_digest,"link_reference_scope")
        snapshot := parse_json(row["snapshot_json"])
        assert(snapshot_digest(snapshot) == context["snapshot_digest"],"link_snapshot_mismatch")
        return snapshot
    }
    prepared_result := func(ref,snapshot) {
        return {"prepared_ref":ref,"terms":snapshot,"expires_at_ms":snapshot["expires_at_ms"],"capabilities_digest":snapshot["capabilities_digest"]}
    }
    prepare := func(intent,context) {
        assert(intent["principal"] == context["principal"] && intent["payee_ref"] == installed["snapshot"]["payee"]["id"] && intent["payment_profile"] == installed["snapshot"]["payment_profile"]["alias"],"link_intent_scope")
        scope := principal_digest(context["principal"])
        ref := "link_"+sha256(frame([scope,context["execution_id"]]))
        prior := db_query(db,"SELECT * FROM link_provider_prepared WHERE ref=?",[ref])
        if len(prior) == 1 {
            assert(prior[0]["intent_digest"] == intent_digest(intent) && prior[0]["installation_digest"] == installation_digest,"link_preparation_conflict")
            return prepared_result(ref,parse_json(prior[0]["snapshot_json"]))
        }
        response := merchant["probe"](context)
        assert(response["status"] == 402,"link_challenge_required")
        challenge := validate_mpp_challenge(response["challenge"],installed["expected"],clock_ms())
        assert(challenge["ok"],"link_challenge_invalid")
        mut snapshot := parse_json(to_json(installed["snapshot"]))
        snapshot["execution_id"] = context["execution_id"]
        snapshot["principal"] = intent["principal"]
        snapshot["intent_digest"] = intent_digest(intent)
        snapshot["capabilities_digest"] = capabilities_digest(installed["capabilities"])
        mut binding := snapshot["request_binding"]
        binding["terms_digest"] = challenge["digest"]
        snapshot["request_binding"] = binding
        mut expires := snapshot["expires_at_ms"]
        if expires > intent["expires_at_ms"] { expires = intent["expires_at_ms"] }
        if expires > challenge["expires_at_ms"] { expires = challenge["expires_at_ms"] }
        if expires > installed["capabilities"]["valid_until_ms"] { expires = installed["capabilities"]["valid_until_ms"] }
        snapshot["expires_at_ms"] = expires
        assert(expires > clock_ms(),"link_preparation_expired")
        assert(prepare_link_submission(db,ref,snapshot,response["challenge"],installed["expected"],clock_ms())["ok"],"link_mpp_preparation")
        db_execute(db,"INSERT OR IGNORE INTO link_provider_prepared VALUES(?,?,?,?,?,?)",[ref,scope,context["execution_id"],installation_digest,intent_digest(intent),to_json(snapshot)])
        saved := db_query(db,"SELECT * FROM link_provider_prepared WHERE ref=?",[ref])
        assert(len(saved) == 1 && saved[0]["installation_digest"] == installation_digest && saved[0]["intent_digest"] == intent_digest(intent) && snapshot_digest(parse_json(saved[0]["snapshot_json"])) == snapshot_digest(snapshot),"link_prepare_race")
        return prepared_result(ref,snapshot)
    }
    authorization_observation := func(snapshot,result) {
        mut outcome := "unknown"
        mut evidence := null
        if result["ok"] == true && result["status"] == "authorized" {
            outcome = "authorized"
            evidence = "link-authorization:"+sha256(snapshot["execution_id"]+snapshot_digest(snapshot))
        }
        return {"schema":"kujo.payment-observation/v1","execution_id":snapshot["execution_id"],"snapshot_digest":snapshot_digest(snapshot),"phase":"authorization","outcome":outcome,"observed_at_ms":clock_ms(),"evidence_ref":evidence,"actual_amount":null,"next_action":null,"retry_after_ms":null}
    }
    request_authorization := func(ref,context) {
        snapshot := load(ref,context)
        assert(clock_ms() < snapshot["expires_at_ms"],"link_authorization_expired")
        result := request_link_authorization(db,ref,snapshot,installed["expected"]["network_id"],installed["payment_method"],installed["test_mode"],api,context["deadline_ms"])
        return authorization_observation(snapshot,result)
    }
    submit := func(ref,context) {
        snapshot := load(ref,context)
        return submit_link_once(db,ref,snapshot,installed["expected"],api,merchant,context,clock_ms)
    }
    observe := func(reference,context) {
        snapshot := load(reference["prepared_ref"],context)
        if context["phase"] == "authorization" {
            result := observe_link_authorization(db,reference["prepared_ref"],snapshot,api,context["deadline_ms"])
            return authorization_observation(snapshot,result)
        }
        assert(context["phase"] == "execution","link_observation_phase")
        return observe_link_submission(reference["prepared_ref"],snapshot,merchant,context,clock_ms)
    }
    describe := func(context) { return parse_json(to_json(installed["capabilities"])) }
    return {"id":"link","version":"0.1.0","describe":describe,"prepare":prepare,"request_authorization":request_authorization,"submit":submit,"observe":observe}
}
