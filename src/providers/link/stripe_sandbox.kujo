// Private, read-only merchant evidence for the Link sandbox integration.
// The merchant owns the durable execution -> PaymentIntent binding. Neither
// requesters nor merchant HTTP response bodies may supply this lookup.
from src.domain.binding import snapshot_digest, frame

export stripe_sandbox_api := func(secret_key, account_id, api_version, clock_ms) {
    assert(type(secret_key) == "string" && regex_match(secret_key,"^(sk|rk)_test_[A-Za-z0-9]+$") && len(secret_key) <= 8192,"stripe_test_key_required")
    assert(type(account_id) == "string" && regex_match(account_id,"^acct_[A-Za-z0-9]+$"),"stripe_account_required")
    assert(type(api_version) == "string" && regex_match(api_version,"^[0-9]{4}-[0-9]{2}-[0-9]{2}(\\.[a-z]+)?$"),"stripe_version_required")
    return func(path,deadline_ms) {
        try {
            if type(path) != "string" || (path != "/v1/account" && regex_match(path,"^/v1/payment_intents/pi_[A-Za-z0-9]+$") == false) || type(deadline_ms) != "int" || clock_ms()+1000 >= deadline_ms { return {"ok":false} }
            result := http_request("https://api.stripe.com"+path,{"method":"GET","headers":{"Authorization":"Bearer "+secret_key,"Stripe-Version":api_version,"Accept":"application/json"},"timeout":1,"max_response_bytes":65536,"redirects":"none","pin_dns":true,"destination_policy":"deny_private"})
            match result {
                case Ok(response): {
                    if response["_status"] != 200 { return {"ok":false} }
                    native := parse_json(response["_body"])
                    if type(native) != "dict" { return {"ok":false} }
                    if path == "/v1/account" && (native["object"] != "account" || native["id"] != account_id) { return {"ok":false} }
                    return {"ok":true,"native":native}
                }
                case Err(error): { return {"ok":false} }
            }
        } except error { return {"ok":false} }
    }
}

export stripe_sandbox_evidence := func(account_id, lookup, api, clock_ms) {
    assert(type(account_id) == "string" && regex_match(account_id,"^acct_[A-Za-z0-9]+$"),"stripe_account_required")
    assert(type(lookup) == "function" && type(api) == "function" && type(clock_ms) == "function","stripe_evidence_installation")
    observe := func(ref,snapshot,context) {
        digest := snapshot_digest(snapshot)
        mut observation := {"schema":"kujo.payment-observation/v1","execution_id":snapshot["execution_id"],"snapshot_digest":digest,"phase":"execution","outcome":"unknown","observed_at_ms":clock_ms(),"evidence_ref":null,"actual_amount":null,"next_action":null,"retry_after_ms":null}
        try {
            if context["execution_id"] != snapshot["execution_id"] || context["snapshot_digest"] != digest || clock_ms()+2000 >= context["deadline_ms"] { return observation }
            binding := lookup(snapshot["execution_id"],digest)
            if type(binding) != "dict" || binding["snapshot_digest"] != digest || binding["stripe_account_id"] != account_id || type(binding["payment_intent_id"]) != "string" || regex_match(binding["payment_intent_id"],"^pi_[A-Za-z0-9]+$") == false { return observation }
            account := api("/v1/account",context["deadline_ms"])
            if account["ok"] != true || account["native"]["object"] != "account" || account["native"]["id"] != account_id { return observation }
            result := api("/v1/payment_intents/"+binding["payment_intent_id"],context["deadline_ms"])
            if result["ok"] != true { return observation }
            native := result["native"]
            if native["object"] != "payment_intent" || native["id"] != binding["payment_intent_id"] || type(native["livemode"]) != "bool" || native["livemode"] != false || native["status"] != "succeeded" { return observation }
            for field in ["amount","amount_received"] {
                if type(native[field]) != "int" || native[field] != snapshot["charge"]["minor"] { return observation }
            }
            if native["currency"] != to_lower(snapshot["charge"]["currency"]) || type(native["amount_capturable"]) != "int" || native["amount_capturable"] != 0 { return observation }
            // This narrow sandbox installation supports direct merchant charges.
            if native["on_behalf_of"] != null || native["transfer_data"] != null { return observation }
            if native["metadata"]["kujo_snapshot_digest"] != digest || native["metadata"]["kujo_execution_id"] != snapshot["execution_id"] { return observation }
            if type(native["latest_charge"]) != "string" || regex_match(native["latest_charge"],"^ch_[A-Za-z0-9]+$") == false || clock_ms() >= context["deadline_ms"] { return observation }
            observation["outcome"] = "succeeded"
            observation["observed_at_ms"] = clock_ms()
            observation["actual_amount"] = snapshot["charge"]
            observation["evidence_ref"] = "stripe-sandbox:"+sha256(frame([account_id,native["id"],native["latest_charge"],digest]))
            return observation
        } except error { return observation }
    }
    verify := func(snapshot,observation) {
        try {
            now := clock_ms()
            fresh := observe(null,snapshot,{"execution_id":snapshot["execution_id"],"snapshot_digest":snapshot_digest(snapshot),"deadline_ms":now+2500})
            // Link's submission port hashes private evidence references once.
            return fresh["outcome"] == "succeeded" && observation["outcome"] == "succeeded" && observation["execution_id"] == fresh["execution_id"] && observation["snapshot_digest"] == fresh["snapshot_digest"] && observation["actual_amount"] == fresh["actual_amount"] && observation["evidence_ref"] == "link-evidence:"+sha256(fresh["evidence_ref"])
        } except error { return false }
    }
    return {"observe":observe,"confirmation":{"id":"stripe-sandbox-direct-charge/v1","assurance":"provider_confirmed","verify":verify}}
}
