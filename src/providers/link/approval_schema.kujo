export approval_schema_v2 := func() {
    return [{"name":"link_approval_outbox_v2","sql":"CREATE TABLE link_approval_outbox_v2(id TEXT PRIMARY KEY,execution_id TEXT NOT NULL,scope TEXT NOT NULL,snapshot_digest TEXT NOT NULL,approval_url TEXT,expires_at_ms INTEGER NOT NULL,retired_at_ms INTEGER,CHECK((approval_url IS NOT NULL AND retired_at_ms IS NULL) OR (approval_url IS NULL AND typeof(retired_at_ms)='integer' AND retired_at_ms>=expires_at_ms)))"},{"name":"link_approval_outbox_immutable","sql":"CREATE TRIGGER link_approval_outbox_immutable BEFORE UPDATE ON link_approval_outbox_v2 WHEN NEW.id!=OLD.id OR NEW.execution_id!=OLD.execution_id OR NEW.scope!=OLD.scope OR NEW.snapshot_digest!=OLD.snapshot_digest OR NEW.expires_at_ms!=OLD.expires_at_ms OR OLD.approval_url IS NULL OR NEW.approval_url IS NOT NULL OR NEW.retired_at_ms IS NULL OR NEW.retired_at_ms<OLD.expires_at_ms BEGIN SELECT RAISE(ABORT,'approval_delivery_immutable'); END"},{"name":"link_approval_outbox_permanent","sql":"CREATE TRIGGER link_approval_outbox_permanent BEFORE DELETE ON link_approval_outbox_v2 BEGIN SELECT RAISE(ABORT,'approval_delivery_permanent'); END"},{"name":"link_approval_outbox_expiry","sql":"CREATE INDEX link_approval_outbox_expiry ON link_approval_outbox_v2(expires_at_ms,id) WHERE approval_url IS NOT NULL"}]
}
