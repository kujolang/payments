// Frozen identities of canonical Payments operations, independent of legacy v1 runtime hashes.
// Reuse Ability v2; never repair or relabel an existing approval/receipt digest.
from ability import ability_definition_digest_v2

export canonical_ability_matches := func(operation, definition) {
    pins := {"cancel":{"algorithm":"sha256-canonical-json-v2","digest":"d46a1ff730f77cf9f686165fcb2bbbdb3996154d7cf1aaedcea4ebebd63b3b1c","id":"kujo.payments.intent.cancel","version":"1.0.0"},"execute":{"algorithm":"sha256-canonical-json-v2","digest":"c621821649b5635a67dcc0ff14ebd209b8fd7a0579298b7ed2dc711ffa7c38e8","id":"kujo.payments.execution.execute","version":"1.0.0"},"inspect":{"algorithm":"sha256-canonical-json-v2","digest":"799a584fbacfe47eadfdaf2b23035fc47b157b17890b0e8afa308f820680060b","id":"kujo.payments.execution.inspect","version":"1.0.0"},"inspect_revision":{"algorithm":"sha256-canonical-json-v2","digest":"bc428da0a6a010670b538477377f98e1e16a576dc85c59a983689df3a83ef168","id":"kujo.payments.execution.inspect","version":"2.0.0"},"reconcile":{"algorithm":"sha256-canonical-json-v2","digest":"9c6ae885c8467824cc1f99f18f8a20d2183acadd35eff3452b043071094d6641","id":"kujo.payments.execution.reconcile","version":"1.0.0"},"request":{"algorithm":"sha256-canonical-json-v2","digest":"3078ff16ea2f2ef0f1ad7cca40debcf8fa01955523f8ab202b0f025dc2bbb5bb","id":"kujo.payments.intent.request","version":"1.0.0"}}
    try {
        if has_key(pins,operation) == false { return false }
        pin := pins[operation]
        if definition["id"] != pin["id"] || definition["version"] != pin["version"] { return false }
        actual := ability_definition_digest_v2(definition)
        return actual["ok"] && actual["algorithm"] == pin["algorithm"] && actual["digest"] == pin["digest"]
    } except e { return false }
}
