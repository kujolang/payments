from src.providers.link.credentials import open_link_credentials
from src.storage.sqlite import open_store
mode := env("PAYMENTS_SEPARATION_MODE")
path := env("PAYMENTS_CREDENTIAL_DB")
if mode == "core_into_vault" {
    db := db_connect("sqlite",path);open_link_credentials(db);db_close(db)
    mut denied := false
    try { opened := open_store(path);db_close(opened) } except error { denied = true }
    assert(denied,"core_refuses_private_vault")
} else {
    if mode == "vault_into_core" { core := open_store(path);db_close(core) }
    db := db_connect("sqlite",path)
    if mode == "drift" { open_link_credentials(db);db_execute(db,"DROP TRIGGER link_credentials_permanent",[]) }
    mut denied := false
    try { open_link_credentials(db) } except error { denied = true }
    assert(denied,"vault_refuses_foreign_or_drifted_schema")
    db_close(db)
}
print(to_json({"ok":true}))
