// Synthetic privileged positive control. Never installed in the agent workload.
from src.providers.link.credentials import open_link_credentials, install_link_credentials
secret := env("PAYMENTS_PROVIDER_SECRET")
assert(len(secret) > 0,"missing_private_canary")
db := db_connect("sqlite","/private/link-vault.db")
open_link_credentials(db)
binding := {"tenant_id":"test","payer_ref":"agent","account_ref":"fixture","client_id":"fixture_client","scope":"spend"}
assert(install_link_credentials(db,"fixture",binding,{"access_token":secret,"refresh_token":secret+"_REFRESH","expires_in":3600,"token_type":"Bearer","scope":"spend"},1000)["ok"],"private_vault_install")
assert(db_query(db,"SELECT access_token FROM link_credentials_v1",[])[0]["access_token"] == secret,"private_vault_positive_control")
db_close(db)
from src.providers.link.authorization import open_link_authorizations, request_link_authorization
from src.providers.link.approval_delivery import open_link_approval_outbox, stage_link_approval, deliver_link_approval
snapshot := parse_json(read_file("/app/domain.json"))["snapshot"]
auth := db_connect("sqlite","/private/link-approval-auth.db");open_link_authorizations(auth)
outbox := db_connect("sqlite","/private/link-approval-outbox.db");open_link_approval_outbox(outbox)
api := func(method,path,body,deadline) { return {"ok":true,"native":{"id":"spend_canary","amount":5500,"currency":"usd","credential_type":"shared_payment_token","network_id":"network_1","status":"pending_approval","approval_url":"https://approve.example/consent/"+secret}} }
request_link_authorization(auth,"canary",snapshot,"network_1","pm_fixture",true,api,10000)
clock := func() { return 1000 }
staged := stage_link_approval(auth,outbox,"canary",snapshot,api,["https://approve.example"],clock,10000)
assert(staged["ok"],"private_approval_stage")
assert(db_query(outbox,"SELECT approval_url FROM link_approval_outbox_v2",[])[0]["approval_url"] == "https://approve.example/consent/"+secret,"private_approval_positive_control")
from src.storage.sqlite import open_store, intake, prepare
from src.storage.port import sqlite_port
from src.domain.binding import principal_digest, snapshot_digest
from src.executor.approval import review_payment
from src.executor.operator_delivery import reviewed_operator_sink
core := open_store("/private/operator-payments.db");store := sqlite_port(core)
payer := snapshot["principal"];scope := principal_digest(payer)
intent := parse_json(read_file("/app/domain.json"))["intent"]
assert(intake(core,scope,"canary","canary","exec_1",intent)["ok"],"operator_intake")
assert(prepare(core,scope,"exec_1",0,snapshot,snapshot_digest(snapshot),1000),"operator_prepare")
definition := parse_json(read_file("contracts/abilities/execute.json"))
review := review_payment(store,payer,"exec_1",definition,1000)
authority := {"payer":payer,"operator":{"type":"human","id":"fixture","tenant_id":payer["tenant_id"]},"issuer_ref":"fixture","ttl_ms":1000}
render := func(payload,deadline) { write_file("/private/operator-approval.json",to_json(payload));return true }
sink := reviewed_operator_sink(store,authority,"exec_1",definition,review["binding_digest"],render,clock)
delivered := deliver_link_approval(outbox,staged["delivery_ref"],snapshot,["https://approve.example"],sink,clock,10000)
assert(delivered["ok"],"reviewed_operator_delivery")
assert(parse_json(read_file("/private/operator-approval.json"))["approval_url"] == "https://approve.example/consent/"+secret,"operator_sink_positive_control")
db_close(core);db_close(auth);db_close(outbox)
print(to_json({"ok":true}))
