// Synthetic privileged positive control. Never installed in the agent workload.
from src.providers.link.credentials import open_link_credentials, install_link_credentials
mut private_root := env("PAYMENTS_CANARY_ROOT");if private_root == "" { private_root = "/private" }
mut domain_path := env("PAYMENTS_CANARY_DOMAIN");if domain_path == "" { domain_path = "/app/domain.json" }
canary_value := env("PAYMENTS_PROVIDER_SECRET")
assert(len(canary_value) > 0,"missing_private_canary")
db := db_connect("sqlite",private_root+"/link-vault.db")
open_link_credentials(db)
binding := {"tenant_id":"test","payer_ref":"agent","account_ref":"fixture","client_id":"fixture_client","scope":"spend"}
assert(install_link_credentials(db,"fixture",binding,{"access_token":canary_value,"refresh_token":canary_value+"_REFRESH","expires_in":3600,"token_type":"Bearer","scope":"spend"},1000)["ok"],"private_vault_install")
assert(db_query(db,"SELECT access_token FROM link_credentials_v1",[])[0]["access_token"] == canary_value,"private_vault_positive_control")
db_close(db)
from src.providers.link.authorization import open_link_authorizations, request_link_authorization
from src.providers.link.approval_delivery import open_link_approval_outbox, stage_link_approval, deliver_link_approval
snapshot := parse_json(read_file(domain_path))["snapshot"]
auth := db_connect("sqlite",private_root+"/link-approval-auth.db");open_link_authorizations(auth)
outbox := db_connect("sqlite",private_root+"/link-approval-outbox.db");open_link_approval_outbox(outbox)
api := func(method,path,body,deadline) { return {"ok":true,"native":{"id":"spend_canary","amount":5500,"currency":"usd","credential_type":"shared_payment_token","network_id":"network_1","status":"pending_approval","approval_url":"https://approve.example/consent/"+canary_value}} }
request_link_authorization(auth,"canary",snapshot,"network_1","pm_fixture",true,api,10000)
clock := func() { return 1000 }
staged := stage_link_approval(auth,outbox,"canary",snapshot,api,["https://approve.example"],clock,10000)
assert(staged["ok"],"private_approval_stage")
assert(db_query(outbox,"SELECT approval_url FROM link_approval_outbox_v2",[])[0]["approval_url"] == "https://approve.example/consent/"+canary_value,"private_approval_positive_control")
from src.storage.sqlite import open_store, intake, prepare
from src.storage.port import sqlite_port
from src.domain.binding import principal_digest, snapshot_digest
from src.executor.approval import review_payment
from src.executor.operator_delivery import reviewed_operator_sink
core := open_store(private_root+"/operator-payments.db");store := sqlite_port(core)
payer := snapshot["principal"];scope := principal_digest(payer)
intent := parse_json(read_file(domain_path))["intent"]
assert(intake(core,scope,"canary","canary","exec_1",intent)["ok"],"operator_intake")
assert(prepare(core,scope,"exec_1",0,snapshot,snapshot_digest(snapshot),1000),"operator_prepare")
definition := parse_json(read_file("contracts/abilities/execute.json"))
review := review_payment(store,payer,"exec_1",definition,1000)
authority := {"payer":payer,"operator":{"type":"human","id":"fixture","tenant_id":payer["tenant_id"]},"issuer_ref":"fixture","ttl_ms":1000}
render := func(payload,deadline) { write_file(private_root+"/operator-approval.json",to_json(payload));return true }
sink := reviewed_operator_sink(store,authority,"exec_1",definition,review["binding_digest"],render,clock)
delivered := deliver_link_approval(outbox,staged["delivery_ref"],snapshot,["https://approve.example"],sink,clock,10000)
assert(delivered["ok"],"reviewed_operator_delivery")
assert(parse_json(read_file(private_root+"/operator-approval.json"))["approval_url"] == "https://approve.example/consent/"+canary_value,"operator_sink_positive_control")
db_close(core);db_close(auth);db_close(outbox)
// Leave both an outstanding device code and received tokens in the private journal.
// Each phase has a distinct canary suffix; the renderer must never receive tokens.
from src.providers.link.enrollment import open_link_enrollment, start_link_enrollment, deliver_link_enrollment, poll_link_enrollment
enrollment := db_connect("sqlite",private_root+"/link-enrollment.db");open_link_enrollment(enrollment)
config := {"credential_id":"enrollment_pending","binding":binding,"label":"Containment fixture","origins":["https://approve.example"]}
device := func(phase,client,value,label,deadline) {
    if phase == "start" { return {"ok":true,"outcome":"received","native":{"device_code":canary_value+"_DEVICE","user_code":"KUJO "+sha256(canary_value),"verification_uri":"https://approve.example/device","verification_uri_complete":"https://approve.example/device?code="+canary_value+"_URL","expires_in":120,"interval":5}} }
    assert(value == canary_value+"_DEVICE","private_device_code")
    return {"ok":true,"outcome":"received","native":{"access_token":canary_value+"_ENROLL_ACCESS","refresh_token":canary_value+"_ENROLL_REFRESH","expires_in":3600,"token_type":"Bearer","scope":"spend"}}
}
assert(start_link_enrollment(enrollment,"pending",config,device,clock,10000)["ok"],"private_enrollment_start")
enrollment_render := func(payload,deadline) {
    assert(has_key(payload,"device_code") == 0 && has_key(payload,"tokens") == 0,"enrollment_renderer_secret_shape")
    write_file(private_root+"/operator-enrollment.json",to_json(payload));return true
}
assert(deliver_link_enrollment(enrollment,"pending",config,enrollment_render,clock,10000)["ok"],"private_enrollment_delivery")
assert(db_query(enrollment,"SELECT device_code FROM link_enrollment_v1 WHERE id='pending'",[])[0]["device_code"] == canary_value+"_DEVICE","private_enrollment_device_positive_control")
assert(parse_json(read_file(private_root+"/operator-enrollment.json"))["user_code"] == "KUJO "+sha256(canary_value),"private_enrollment_operator_positive_control")
config["credential_id"] = "enrollment_received"
assert(start_link_enrollment(enrollment,"received",config,device,clock,10000)["ok"],"private_enrollment_second_start")
poll_clock := func() { return 6000 }
assert(poll_link_enrollment(enrollment,"received",config,device,poll_clock,16000)["ok"],"private_enrollment_poll")
row := db_query(enrollment,"SELECT state,tokens_json,device_code,operator_json FROM link_enrollment_v1 WHERE id='received'",[])[0]
assert(row["state"] == "received" && parse_json(row["tokens_json"])["refresh_token"] == canary_value+"_ENROLL_REFRESH","private_enrollment_tokens_positive_control")
assert(row["device_code"] == null && row["operator_json"] == null,"private_enrollment_phase_cleanup")
db_close(enrollment)
print(to_json({"ok":true}))
