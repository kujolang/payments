from src.providers.link.credentials import open_link_credentials, install_link_credentials, inspect_link_credentials, refresh_link_credentials, disable_link_credentials, link_credential_api
from src.providers.link.oauth import link_oauth_refresh, link_refresh_form

db := db_connect("sqlite",env("PAYMENTS_CREDENTIAL_DB"))
open_link_credentials(db)
binding := {"tenant_id":"tenant","payer_ref":"payer","account_ref":"account","client_id":"registered_fixture","scope":"spend offline"}
old := {"access_token":"SENTINEL_ACCESS_OLD","refresh_token":"SENTINEL_REFRESH_OLD","expires_in":60,"token_type":"Bearer","scope":"offline spend"}
new := {"access_token":"SENTINEL_ACCESS_NEW","refresh_token":"SENTINEL_REFRESH_NEW","expires_in":120,"token_type":"Bearer","scope":"spend offline"}
clock := func() {
    try {
        marker := read_file(env("PAYMENTS_CREDENTIAL_MARKER"))
        if marker == "late" { return 3000 }
        if marker == "rollback" { return 0 }
    } except error { }
    return 1000
}
mode := env("PAYMENTS_CREDENTIAL_ACTION")
if mode == "install" {
    print(to_json(install_link_credentials(db,"session",binding,old,1000)))
    db_close(db);exit(0)
}
if mode == "inspect" { print(to_json(inspect_link_credentials(db,"session",binding)));db_close(db);exit(0) }
if mode == "disable" { print(to_json(disable_link_credentials(db,"session",binding,0)));db_close(db);exit(0) }
if mode == "deny" {
    for field in ["tenant_id","payer_ref","account_ref","client_id","scope"] {
        wrong := parse_json(to_json(binding));wrong[field] = "other"
        assert(inspect_link_credentials(db,"session",wrong)["ok"] == false,"credential_binding_scope")
    }
    assert(install_link_credentials(db,"session",binding,old,1000)["ok"] == false,"no_reinstallation")
    native := link_oauth_refresh(clock)
    assert(link_refresh_form("registered_fixture","abc+/==") == "grant_type=refresh_token&client_id=registered_fixture&refresh_token=abc%2B%2F%3D%3D","oauth_form_encoding")
    assert(native("bad-client&other","SENTINEL_REFRESH_OLD",10000)["ok"] == false,"native_client_denied")
    assert(native("registered_fixture","SENTINEL_REFRESH_OLD",1001)["ok"] == false,"native_deadline_denied")
    api := link_credential_api(db,"session",binding,clock)
    assert(api("GET","/spend_requests/test",null,61000)["ok"] == false,"access_expiry_denied")
    print(to_json({"ok":true}));db_close(db);exit(0)
}
ledger := db_connect("sqlite",env("PAYMENTS_CREDENTIAL_LEDGER"))
db_query(ledger,"PRAGMA busy_timeout=5000",[])
refresh := func(client,token,deadline) {
    assert(client == "registered_fixture" && token == "SENTINEL_REFRESH_OLD","private_rotation_input")
    db_execute(ledger,"INSERT INTO calls VALUES(1)",[])
    if mode == "crash" { write_file(env("PAYMENTS_CREDENTIAL_MARKER"),"rotated");sleep(30000) }
    if mode == "lost" { assert(false,"SENTINEL_NATIVE_ERROR_REFRESH_OLD") }
    if mode == "scope" { changed := parse_json(to_json(new));changed["scope"] = "spend offline extra";return {"ok":true,"native":changed} }
    if mode == "late" { changed := parse_json(to_json(new));changed["expires_in"] = 1;write_file(env("PAYMENTS_CREDENTIAL_MARKER"),"late");return {"ok":true,"native":changed} }
    if mode == "rollback" { write_file(env("PAYMENTS_CREDENTIAL_MARKER"),"rollback") }
    if mode == "malformed" { return {"ok":true,"native":{"access_token":"SENTINEL_NATIVE_INVALID"}} }
    if mode == "disable_race" { assert(disable_link_credentials(db,"session",binding,1)["ok"],"disable_inflight") }
    if mode == "commit_failure" { db_execute(db,"CREATE TRIGGER fault BEFORE UPDATE ON link_credentials_v1 WHEN NEW.state='active' BEGIN SELECT RAISE(ABORT,'SENTINEL_WRITE_FAILURE'); END",[]) }
    return {"ok":true,"native":new}
}
result := refresh_link_credentials(db,"session",binding,0,refresh,clock,10000)
if mode == "after_commit" { write_file(env("PAYMENTS_CREDENTIAL_MARKER"),"committed");sleep(30000) }
print(to_json(result))
db_close(ledger);db_close(db)
