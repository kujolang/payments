// Synthetic installation for exercising the real bounded worker across processes.
from src.storage.sqlite import open_store, intake
from src.storage.port import sqlite_port
from src.domain.binding import principal_digest, snapshot_digest
from src.providers.fixture.provider import fixture_provider
from src.application.worker import worker_step

v := parse_json(read_file(env("PAYMENTS_WORKER_FIXTURE")))
db := open_store(env("PAYMENTS_TEST_DB"))
processor := db_connect("sqlite",env("PAYMENTS_TEST_DB")+".processor")
principal := v["intent"]["principal"]
assert(intake(db,principal_digest(principal),"worker-key","worker-request","exec_1",v["intent"])["ok"],"intake")
provider := fixture_provider(processor,v["snapshot"],v["capabilities"],env("PAYMENTS_FIXTURE_BEHAVIOR"))
mut schemas := {}
for name in ["intent","snapshot","capabilities","observation"] { schemas[name] := parse_json(read_file("contracts/"+name+".schema.json")) }
verify := func(snapshot, observation) {
    rows := db_query(processor,"SELECT snapshot_json FROM fixture_charges WHERE ref=?",[snapshot["execution_id"]])
    return len(rows) == 1 && snapshot_digest(parse_json(rows[0]["snapshot_json"])) == snapshot_digest(snapshot)
}
installed := {"provider":provider,"schemas":schemas,"currency_table":{"version":"fixture-v1","exponents":{"USD":2}},"region":"US","definition":parse_json(read_file("contracts/abilities/execute.json")),"reconciliation_definition":parse_json(read_file("contracts/abilities/reconcile.json")),"confirmation":{"id":"fixture-ledger-v1","assurance":"provider_confirmed","verify":verify}}
clock := func() { return current_timestamp() }
policy := func(snapshot, invocation) { if invocation["ability_id"] == "kujo.payments.execution.reconcile" { return {"schema":"kujo.ability.policy-decision/v1","decision_id":"fixture-observation","outcome":"allow","reason":"Observe only","requirements":[],"policy_id":"fixture-observation","policy_version":"1.0.0"} } return {"schema":"kujo.ability.policy-decision/v1","decision_id":"fixture-worker-policy","outcome":"approval_required","reason":"Separate operator approval required.","requirements":["human"],"policy_id":"fixture-worker","policy_version":"1.0.0"} }
audit := func(phase,invocation,payload) {
    id := invocation["invocation_id"]+":"+phase
    db_execute(db,"INSERT OR IGNORE INTO audit VALUES(?,NULL,?)",[id,phase])
    return {"ok":true,"written":true,"phase":phase,"event_id":id}
}
// Test-only fault seams surround real committed store operations. No production
// hook or timeout-based ownership transfer is introduced.
func checkpoint(name) {
    if env("PAYMENTS_WORKER_STOP") == name {
        write_file(env("PAYMENTS_TEST_MARKER"),"ready")
        deadline := current_timestamp()+30000
        while file_exists(env("PAYMENTS_TEST_RELEASE")) == false && current_timestamp() < deadline { sleep(20) }
        assert(file_exists(env("PAYMENTS_TEST_RELEASE")),"test_release_timeout")
    }
}
store := sqlite_port(db)
begin := store["begin_ability"]
claim := store["claim"]
record := store["record_observation"]
store["begin_ability"] = func(operation,key,digest,id) {
    checkpoint("before_begin")
    value := begin(operation,key,digest,id)
    checkpoint("after_begin")
    return value
}
store["claim"] = func(scope,id,revision,approval,binding,digest,invocation,now) {
    checkpoint("before_claim")
    value := claim(scope,id,revision,approval,binding,digest,invocation,now)
    if value { checkpoint("after_claim") }
    return value
}
store["record_observation"] = func(scope,id,revision,evidence,digest,observation,event,receipt) {
    checkpoint("before_observation")
    return record(scope,id,revision,evidence,digest,observation,event,receipt)
}
result := worker_step(store,principal,"exec_1",installed,{"clock_ms":clock,"policy":policy,"audit":audit,"reconciliation_key":uuid_v4()})
print(to_json(result))
db_close(processor)
db_close(db)
